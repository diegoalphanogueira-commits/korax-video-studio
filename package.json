{
  "name": "korax-video-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts KoraxAd out/korax-ad.mp4 --codec=h264 --crf=18",
    "render:preview": "remotion render src/index.ts KoraxAd out/korax-ad-preview.mp4 --codec=h264 --crf=28 --scale=0.5",
    "typecheck": "tsc --noEmit",
    "prepare:demo": "node scripts/prepare-demo.mjs",
    "render:demo": "remotion render src/index.ts KoraxDemo out/korax-demo-final.mp4 --codec=h264 --crf=18",
    "render:demo:preview": "remotion render src/index.ts KoraxDemo out/korax-demo-preview.mp4 --codec=h264 --crf=28 --scale=0.5",
    "render:style:preview": "remotion render src/index.ts KoraxDemoStyle out/korax-demo-style-preview.mp4 --frames=0-531 --codec=h264 --crf=20 --scale=0.5 --concurrency=2",
    "render:motion:preview": "remotion render src/index.ts KoraxDemoMotion out/korax-demo-motion-preview.mp4 --codec=h264 --crf=18 --scale=0.5 --concurrency=2",
    "render:complete": "remotion render src/index.ts KoraxDemoComplete out/korax-demo-v3-1080p.mp4 --codec=h264 --crf=18 --concurrency=3",
    "render:complete:preview": "remotion render src/index.ts KoraxDemoComplete out/korax-demo-telas-1080p.mp4 --frames=0-1634 --codec=h264 --crf=18 --concurrency=3"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@remotion/cli": "4.0.533",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.2"
  }
}
